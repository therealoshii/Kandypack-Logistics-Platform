# Copy this file to ".env" (same folder) and set your own values.
# ".env" is git-ignored, so real passwords never reach the repository.
# docker compose reads ".env" automatically.
#
# Avoid the characters $ # and spaces in the values.

# Root password of the MySQL container. It is applied when the database volume is first
# created. To change it later, run "docker compose down -v" first (this deletes the local data;
# the seed recreates it).
DB_ROOT_PASSWORD=replace-with-your-database-password

# First administrator account. The backend creates it (or gives the seeded "admin" account a
# real password) when it starts. The password must be 12 to 72 characters long.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345678
